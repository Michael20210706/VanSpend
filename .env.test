# 测试专用环境变量(可提交，不含任何密钥)。Vitest 启动时以"覆盖"方式加载本文件，
# 再由 src/db.cjs 从 .env 补齐这里没写的变量(MYSQL_USER/MYSQL_PASSWORD 等)。
# 需要本机特有的覆盖(如别的 MYSQL_HOST)写到 .env.test.local(已 gitignore)。
#
# MYSQL_DATABASE 必须以 _test 结尾，否则测试拒绝启动——防止误连生产库。
# 测试开始前会 DROP 并重建这个库。
MYSQL_HOST=127.0.0.1
MYSQL_DATABASE=vanspend_test
SESSION_SECRET=vitest-only-session-secret-0123456789abcdef
ADMIN_USERNAME=__test_admin__
ADMIN_PASSWORD=__test_admin_password__
COOKIE_SECURE=false
# 测试里绝不能真的调用计费的 OpenRouter: 用无效 key 兜底，所有识别调用都必须在测试中 mock
OPENROUTER_API_KEY=sk-or-test-invalid
