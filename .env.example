# 复制为 .env，填入你的 OpenRouter API Key
# 获取地址: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 网页端口(Next.js 原生读取 PORT 环境变量；config.json 里不再有 port 字段)
PORT=3000

# 可选: 覆盖 config/config.json 里的 model，不填则用 config.json 的默认值
# OPENROUTER_MODEL=google/gemini-2.5-flash

# MySQL 连接信息。docker compose 默认使用自带的 mysql 服务(不对外发布端口，容器里的 app 固定连 mysql:3306，
# 不受下面 MYSQL_HOST/MYSQL_PORT 影响)；MYSQL_USER/MYSQL_PASSWORD/MYSQL_DATABASE 会被用来创建该库和只有该库权限的专用账号。
# MYSQL_USER 不能是 root。三个密码都请换成自己的随机串(例如 openssl rand -hex 16)。
# 直接 npm run dev / npm start 本机运行: 把 MYSQL_HOST/MYSQL_PORT 指向一个可达的 MySQL
# (用自带的 mysql 服务时，复制 docker-compose.override.example.yml 为 docker-compose.override.yml，然后 MYSQL_PORT=3307)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=vanspend
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=vanspend

# 自带 mysql 服务的 root 密码(必填；指向外部 MySQL 时可忽略)。应用不使用 root，只有建库/运维和 npm test 需要
MYSQL_ROOT_PASSWORD=change-me-too

# 可选: 自动备份(compose 的 backup 服务): 每隔多少小时一份、保留最近几份
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=14

# 登录会话签名密钥，改成任意一串随机字符串即可(不要用下面的示例值)
SESSION_SECRET=change-me-to-a-random-string

# 公网部署(经 Cloudflare Tunnel，浏览器走 HTTPS)时必须设为 true，会话 cookie 才只经 HTTPS 发送；
# 本地 http://localhost 开发/试用保持 false，否则部分浏览器(如 Safari)不回传 cookie、无法登录
COOKIE_SECURE=false

# Cloudflare Tunnel 的 token(Zero Trust 后台创建 Tunnel 时给出)，仅 `docker compose --profile tunnel up` 需要
# TUNNEL_TOKEN=

# 管理后台账号: 留空(两者都不填)则不会自动创建管理员账号；
# 只在该用户名首次出现时创建一次，已存在的账号(不管是不是管理员)不会被覆盖密码/角色
# 公网部署务必设置自己的强密码；密码留着示例值 change-me-admin 时不会创建管理员
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
