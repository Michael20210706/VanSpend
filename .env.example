# 复制为 .env，填入你的 OpenRouter API Key
# 获取地址: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选: 覆盖 config/config.json 里的 model，不填则用 config.json 的默认值
# OPENROUTER_MODEL=google/gemini-2.5-flash

# MySQL 连接信息 (MYSQL_DATABASE 指定的库需提前建好，参见 sql/schema.sql)
# 直接 npm start 本机运行: 指向你的外部 MySQL 实例
# docker-compose up 且使用其自带的 mysql service: MYSQL_HOST 改成 mysql (compose 内的服务名)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=vanspend
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=vanspend

# 仅 docker-compose 自带的 mysql service 需要，指向外部 MySQL 时可忽略
MYSQL_ROOT_PASSWORD=change-me-too
